{
  "buildCommand": "npm run build",
  "framework": "angular",
  "outputDirectory": "dist/PharmaManager/browser",
  "env": {
    "SUPABASE_URL": {
      "description": "Supabase project URL"
    },
    "SUPABASE_ANON_KEY": {
      "description": "Supabase anonymous key for client-side access"
    },
    "VAPID_PUBLIC_KEY": {
      "description": "Public VAPID key for push notifications"
    }
  },
  "headers": [
    {
      "source": "/ngsw-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/ngsw.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
